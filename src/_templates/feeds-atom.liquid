---
permalink: /feeds/feeds.xml
eleventyExcludeFromCollections: true
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?><feed xmlns="http://www.w3.org/2005/Atom"><generator uri="https://www.11ty.dev/">Eleventy</generator><link href="{{ '/feeds/feeds.xml' | absolute_url }}" rel="self" type="application/atom+xml" /><link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" /><updated>{{ site.time | date_to_xmlschema }}</updated><id>{{ '/feeds/feeds.xml' | absolute_url }}</id><title type="html">{{ site.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title><subtitle>{{ site.description | strip_html | normalize_whitespace | xml_escape }}</subtitle>{% for post in site.posts limit: 20 %}<entry><title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title><link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" /><published>{{ post.date | date_to_xmlschema }}</published><updated>{% if post.last_modified_at %}{{ post.last_modified_at | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</updated><id>{{ post.id | absolute_url | xml_escape }}</id><content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}"><![CDATA[{{ post.content | strip }}]]></content>{% if post.excerpt and post.excerpt != empty %}<summary type="html"><![CDATA[{{ post.excerpt | markdownify | strip_html | normalize_whitespace }}]]></summary>{% endif %}{% for category in post.categories %}<category term="{{ category | xml_escape }}" />{% endfor %}{% for tag in post.tags %}<category term="{{ tag | xml_escape }}" />{% endfor %}</entry>{% endfor %}</feed>
