---
permalink: /feed.xml
eleventyExcludeFromCollections: true
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?><feed xmlns="http://www.w3.org/2005/Atom" ><generator uri="https://jekyllrb.com/" version="4.4.1">Jekyll</generator><link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" /><link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" /><updated>{{ site.time | date_to_xmlschema }}</updated><id>{{ '/feed.xml' | absolute_url }}</id><title type="html">{{ site.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title><subtitle>{{ site.description | strip_html | normalize_whitespace | xml_escape }}</subtitle>{% for post in site.posts limit: 10 %}<entry{% if post.lang %} xml:lang="{{ post.lang }}"{% endif %}><title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title><link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" /><published>{{ post.date | date_to_xmlschema }}</published><updated>{% if post.last_modified_at %}{{ post.last_modified_at | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</updated><id>{{ post.id | absolute_url | xml_escape }}</id><content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}"><![CDATA[{{ post.content | strip }}]]></content>{% assign post_author = site.data.authors[post.author] | default: post.author %}{% if post_author %}<author><name>{% if post_author.name %}{{ post_author.name | xml_escape }}{% else %}{{ post_author | xml_escape }}{% endif %}</name>{% if post_author.email %}<email>{{ post_author.email | xml_escape }}</email>{% endif %}{% if post_author.uri %}<uri>{{ post_author.uri | xml_escape }}</uri>{% endif %}</author>{% endif %}{% for category in post.categories %}<category term="{{ category | xml_escape }}" />{% endfor %}{% for tag in post.tags %}<category term="{{ tag | xml_escape }}" />{% endfor %}{% if post.excerpt and post.excerpt != empty %}<summary type="html"><![CDATA[{{ post.excerpt | markdownify | strip_html | normalize_whitespace }}]]></summary>{% endif %}{% assign post_image = post.image.path | default: post.image %}{% if post_image %}{% unless post_image contains "://" %}{% assign post_image = post_image | absolute_url %}{% endunless %}<media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ post_image | xml_escape }}" /><media:content medium="image" url="{{ post_image | xml_escape }}" xmlns:media="http://search.yahoo.com/mrss/" />{% endif %}</entry>{% endfor %}</feed>
