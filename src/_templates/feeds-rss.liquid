---
permalink: /feeds/feeds.rss
eleventyExcludeFromCollections: true
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <description>{{ site.description | strip_html | normalize_whitespace | xml_escape }}</description>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
{% for post in site.posts limit: 20 %}
    <item>
      <title>{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
      <link>{{ post.url | absolute_url | xml_escape }}</link>
      <guid>{{ post.id | absolute_url | xml_escape }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description><![CDATA[{{ post.excerpt | markdownify | strip_html | normalize_whitespace }}]]></description>
    </item>
{% endfor %}
  </channel>
</rss>
